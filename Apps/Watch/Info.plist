<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>LineWise</string>
  <key>WKApplication</key>
  <true/>
  <key>WKWatchKitApp</key>
  <true/>
  <key>WKCompanionAppBundleIdentifier</key>
  <string>com.linewise.app</string>
  <key>NSHealthShareUsageDescription</key>
  <string>LineWise reads live workout data only while your climbing workout is active.</string>
  <key>NSHealthUpdateUsageDescription</key>
  <string>LineWise saves the climbing workout that you explicitly start on Apple Watch.</string>
  <key>WKBackgroundModes</key>
  <array>
    <string>workout-processing</string>
  </array>
</dict>
</plist>
